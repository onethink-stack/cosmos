# provas e problemas da t1: o SHA-256 de cada arquivo está em certificados.json,
# então as linhas terminam em LF em todo sistema
especificacao/provas-t1/** text eol=lf
# a implementação independente (do GPT) fica byte a byte como ele a entregou, com as linhas em CRLF: assim o SHA-256
# de cada arquivo é o mesmo que ele publicou
especificacao/provas-t1/independente/** -text
