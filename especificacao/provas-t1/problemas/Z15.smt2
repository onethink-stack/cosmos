; Z15: crença não é verdade (sem T)
; B[Ana] P(a)
; ¬P(a)
; tradução t1 do Caderno; veredito do Z3 5.1.0.0: sat
(set-logic ALL)
(declare-sort Obj 0)
(declare-sort Mundo 0)
(declare-fun |p:P/1| (Mundo Obj) Bool)
(declare-fun |c:a| () Obj)
(declare-fun |R:Ana| (Mundo Mundo) Bool)
(declare-fun w0 () Mundo)
(assert (forall ((w!1 Mundo)) (=> (|R:Ana| w0 w!1) (|p:P/1| w!1 |c:a|))))
(assert (not (|p:P/1| w0 |c:a|)))
(assert (forall ((a!2 Mundo)) (exists ((b!3 Mundo)) (|R:Ana| a!2 b!3))))
(assert (forall ((a!2 Mundo) (b!3 Mundo) (c!4 Mundo))
  (=> (and (|R:Ana| a!2 b!3) (|R:Ana| b!3 c!4)) (|R:Ana| a!2 c!4))))
(assert (forall ((a!2 Mundo) (b!3 Mundo) (c!4 Mundo))
  (=> (and (|R:Ana| a!2 b!3) (|R:Ana| a!2 c!4)) (|R:Ana| b!3 c!4))))
(check-sat)
