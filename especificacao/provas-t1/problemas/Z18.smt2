; Z18: KD45: 5 (euclidiana)
; ¬B[Ana] P(a)
; ¬B[Ana] ¬B[Ana] P(a)
; tradução t1 do Caderno; veredito do Z3 5.1.0.0: unsat
(set-logic ALL)
(declare-sort Obj 0)
(declare-sort Mundo 0)
(declare-fun |p:P/1| (Mundo Obj) Bool)
(declare-fun |c:a| () Obj)
(declare-fun |R:Ana| (Mundo Mundo) Bool)
(declare-fun w0 () Mundo)
(assert (not (forall ((w!1 Mundo)) (=> (|R:Ana| w0 w!1) (|p:P/1| w!1 |c:a|)))))
(assert (not (forall ((w!2 Mundo))
       (let ((a!1 (not (forall ((w!3 Mundo))
                         (=> (|R:Ana| w!2 w!3) (|p:P/1| w!3 |c:a|))))))
         (=> (|R:Ana| w0 w!2) a!1)))))
(assert (forall ((a!4 Mundo)) (exists ((b!5 Mundo)) (|R:Ana| a!4 b!5))))
(assert (forall ((a!4 Mundo) (b!5 Mundo) (c!6 Mundo))
  (=> (and (|R:Ana| a!4 b!5) (|R:Ana| b!5 c!6)) (|R:Ana| a!4 c!6))))
(assert (forall ((a!4 Mundo) (b!5 Mundo) (c!6 Mundo))
  (=> (and (|R:Ana| a!4 b!5) (|R:Ana| a!4 c!6)) (|R:Ana| b!5 c!6))))
(check-sat)
