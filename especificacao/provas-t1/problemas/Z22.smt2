; Z22: crença e possibilidade
; B[Ana] P(a)
; ◇¬P(a)
; tradução t1 do Caderno; veredito do Z3 5.1.0.0: unknown
(set-logic ALL)
(declare-sort Obj 0)
(declare-sort Mundo 0)
(declare-fun |p:P/1| (Mundo Obj) Bool)
(declare-fun |c:a| () Obj)
(declare-fun |R:Ana| (Mundo Mundo) Bool)
(declare-fun w0 () Mundo)
(assert (forall ((w!1 Mundo)) (=> (|R:Ana| w0 w!1) (|p:P/1| w!1 |c:a|))))
(assert (exists ((w!2 Mundo)) (not (|p:P/1| w!2 |c:a|))))
(assert (forall ((a!3 Mundo)) (exists ((b!4 Mundo)) (|R:Ana| a!3 b!4))))
(assert (forall ((a!3 Mundo) (b!4 Mundo) (c!5 Mundo))
  (=> (and (|R:Ana| a!3 b!4) (|R:Ana| b!4 c!5)) (|R:Ana| a!3 c!5))))
(assert (forall ((a!3 Mundo) (b!4 Mundo) (c!5 Mundo))
  (=> (and (|R:Ana| a!3 b!4) (|R:Ana| a!3 c!5)) (|R:Ana| b!4 c!5))))
(check-sat)
