; Z26: ⟺ como igualdade de verdades
; P(a) ⟺ Q(a)
; P(a)
; ¬Q(a)
; tradução t1 do Caderno; veredito do Z3 5.1.0.0: unsat
(set-logic ALL)
(declare-sort Obj 0)
(declare-sort Mundo 0)
(declare-fun |p:Q/1| (Mundo Obj) Bool)
(declare-fun |c:a| () Obj)
(declare-fun w0 () Mundo)
(declare-fun |p:P/1| (Mundo Obj) Bool)
(assert (= (|p:P/1| w0 |c:a|) (|p:Q/1| w0 |c:a|)))
(assert (|p:P/1| w0 |c:a|))
(assert (not (|p:Q/1| w0 |c:a|)))
(check-sat)
