(assume a0 (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))))
(step t0 (cl (not (= (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))) false)) (not (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|))))) false) :rule equiv_pos2)
(anchor :step t1 :args ((z!1 Obj) (:= (z!1 Obj) z!1)))
(step t1.t0 (cl (= (=> false (pertence w0 z!1 |c:A|)) true)) :rule rare_rewrite :args ("bool-impl-false2" (pertence w0 z!1 |c:A|)))
(step t1 (cl (= (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|))) (forall ((z!1 Obj)) true))) :rule bind)
(step t2 (cl (= (forall ((z!1 Obj)) true) true)) :rule qnt_rm_unused)
(step t3 (cl (= (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|))) true)) :rule trans :premises (t1 t2))
(step t4 (cl (= (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))) (not true))) :rule cong :premises (t3))
