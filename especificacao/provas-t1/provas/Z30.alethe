(step t6 (cl (= (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))) false)) :rule trans :premises (t4 t5))
(step t7 (cl false) :rule resolution :premises (t0 t6 a0) :args ((= (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))) false) false (not (forall ((z!1 Obj)) (=> false (pertence w0 z!1 |c:A|)))) false))
(step t8 (cl (not false)) :rule false)
(step t9 (cl) :rule resolution :premises (t7 t8) :args (false true))
