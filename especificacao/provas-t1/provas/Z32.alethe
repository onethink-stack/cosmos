(assume a0 (= (+ |n:n| 1/1) |n:n|))
(step t0 (cl (not (= (= (+ |n:n| 1/1) |n:n|) false)) (not (= (+ |n:n| 1/1) |n:n|)) false) :rule equiv_pos2)
(step t1 (cl (= (+ |n:n| 1/1) (+ 1/1 |n:n|))) :rule poly_simp)
(step t2 (cl (= |n:n| |n:n|)) :rule refl)
(step t3 (cl (= (= (+ |n:n| 1/1) |n:n|) (= (+ 1/1 |n:n|) |n:n|))) :rule cong :premises (t1 t2))
(step t4 (cl (= (= (+ 1/1 |n:n|) |n:n|) (and (>= (+ 1/1 |n:n|) |n:n|) (<= (+ 1/1 |n:n|) |n:n|)))) :rule rare_rewrite :args ("arith-eq-elim-real" (+ 1/1 |n:n|) |n:n|))
(step t5 (cl (= (>= (+ 1/1 |n:n|) |n:n|) (>= (- (+ 1/1 |n:n|) |n:n|) 0/1))) :rule rare_rewrite :args ("arith-geq-norm1-real" (+ 1/1 |n:n|) |n:n|))
(step t6 (cl (= (- (+ 1/1 |n:n|) |n:n|) 1/1)) :rule poly_simp)
(step t7 (cl (= 0/1 0/1)) :rule refl)
(step t8 (cl (= (>= (- (+ 1/1 |n:n|) |n:n|) 0/1) (>= 1/1 0/1))) :rule cong :premises (t6 t7))
(step t9 (cl (= (>= 1/1 0/1) true)) :rule evaluate)
(step t10 (cl (= (>= (- (+ 1/1 |n:n|) |n:n|) 0/1) true)) :rule trans :premises (t8 t9))
(step t11 (cl (= (>= (+ 1/1 |n:n|) |n:n|) true)) :rule trans :premises (t5 t10))
(step t12 (cl (= (<= (+ 1/1 |n:n|) |n:n|) (>= |n:n| (+ 1/1 |n:n|)))) :rule rare_rewrite :args ("arith-elim-leq" (+ 1/1 |n:n|) |n:n|))
(step t13 (cl (= (>= |n:n| (+ 1/1 |n:n|)) (>= (- |n:n| (+ 1/1 |n:n|)) 0/1))) :rule rare_rewrite :args ("arith-geq-norm1-real" |n:n| (+ 1/1 |n:n|)))
(step t14 (cl (= (- |n:n| (+ 1/1 |n:n|)) -1/1)) :rule poly_simp)
(step t15 (cl (= (>= (- |n:n| (+ 1/1 |n:n|)) 0/1) (>= -1/1 0/1))) :rule cong :premises (t14 t7))
(step t16 (cl (= (>= -1/1 0/1) false)) :rule evaluate)
(step t17 (cl (= (>= (- |n:n| (+ 1/1 |n:n|)) 0/1) false)) :rule trans :premises (t15 t16))
(step t18 (cl (= (>= |n:n| (+ 1/1 |n:n|)) false)) :rule trans :premises (t13 t17))
(step t19 (cl (= (<= (+ 1/1 |n:n|) |n:n|) false)) :rule trans :premises (t12 t18))
(step t20 (cl (= (and (>= (+ 1/1 |n:n|) |n:n|) (<= (+ 1/1 |n:n|) |n:n|)) (and true false))) :rule cong :premises (t11 t19))
(step t21 (cl (= (and true false) false)) :rule evaluate)
(step t22 (cl (= (and (>= (+ 1/1 |n:n|) |n:n|) (<= (+ 1/1 |n:n|) |n:n|)) false)) :rule trans :premises (t20 t21))
(step t23 (cl (= (= (+ 1/1 |n:n|) |n:n|) false)) :rule trans :premises (t4 t22))
(step t24 (cl (= (= (+ |n:n| 1/1) |n:n|) false)) :rule trans :premises (t3 t23))
(step t25 (cl false) :rule resolution :premises (t0 t24 a0) :args ((= (= (+ |n:n| 1/1) |n:n|) false) false (= (+ |n:n| 1/1) |n:n|) false))
(step t26 (cl (not false)) :rule false)
(step t27 (cl) :rule resolution :premises (t25 t26) :args (false true))
