; tradução t1 do Caderno
(set-logic ALL)
(declare-sort Obj 0)
(declare-sort Mundo 0)
(declare-fun |p:Irmas/2| (Mundo Obj Obj) Bool)
(declare-fun w0 () Mundo)
(declare-fun |f:mae/1| (Mundo Obj) Obj)
(declare-fun |c:bia| () Obj)
(declare-fun |c:ana| () Obj)
(assert (forall ((x!1 Obj))
  (forall ((y!2 Obj))
    (=> (= (|f:mae/1| w0 x!1) (|f:mae/1| w0 y!2)) (|p:Irmas/2| w0 x!1 y!2)))))
(assert (= (|f:mae/1| w0 |c:ana|) (|f:mae/1| w0 |c:bia|)))
(assert (not (|p:Irmas/2| w0 |c:ana| |c:bia|)))
(check-sat)
