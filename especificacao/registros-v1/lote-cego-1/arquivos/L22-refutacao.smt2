(set-logic ALL)
(declare-sort Mundo 0)
(declare-fun |p:Molhado/0| (Mundo) Bool)
(declare-fun |R:Ana| (Mundo Mundo) Bool)
(declare-fun w0 () Mundo)
(declare-fun |p:Chove/0| (Mundo) Bool)
(assert (let ((a!1 (forall ((w!2 Mundo))
             (=> (|R:Ana| w0 w!2) (=> (|p:Chove/0| w!2) (|p:Molhado/0| w!2))))))
(let ((a!2 (and (forall ((w!1 Mundo)) (=> (|R:Ana| w0 w!1) (|p:Chove/0| w!1)))
                a!1)))
(let ((a!3 (=> a!2
               (forall ((w!3 Mundo)) (=> (|R:Ana| w0 w!3) (|p:Molhado/0| w!3))))))
  (not a!3)))))
(assert (forall ((a!4 Mundo)) (exists ((b!5 Mundo)) (|R:Ana| a!4 b!5))))
(assert (forall ((a!4 Mundo) (b!5 Mundo) (c!6 Mundo))
  (=> (and (|R:Ana| a!4 b!5) (|R:Ana| b!5 c!6)) (|R:Ana| a!4 c!6))))
(assert (forall ((a!4 Mundo) (b!5 Mundo) (c!6 Mundo))
  (=> (and (|R:Ana| a!4 b!5) (|R:Ana| a!4 c!6)) (|R:Ana| b!5 c!6))))
(check-sat)
