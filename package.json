{
  "name": "cosmos-502426c",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:3-notebooks": "vitest run testes/teste-3-notebooks.test.ts --reporter verbose",
    "typecheck": "tsc --noEmit && tsc --noEmit -p servidor",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build --mode arquivo && vite build",
    "build:arquivo": "tsc --noEmit && vite build --mode arquivo",
    "build:tudo": "npm run build",
    "preview": "vite preview --host",
    "icones": "node scripts/gerar-branding-cosmos.mjs",
    "cifrar": "node --experimental-strip-types --no-warnings scripts/cifrar-sistema.ts",
    "motor:montar": "vite build --config servidor/vite.config.ts --logLevel warn",
    "motor": "npm run motor:montar && node --no-warnings servidor/dist/motor-de-fundo.js",
    "motor:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File servidor/iniciar-com-o-windows.ps1",
    "motor:windows:remover": "powershell -NoProfile -ExecutionPolicy Bypass -File servidor/iniciar-com-o-windows.ps1 -Remover",
    "v2:api": "vite build --config src/v2/vite.config.ts && node dist-v2/api.mjs",
    "ots:stamp": "python scripts/cosmos-ots.py stamp",
    "ots:verify": "python scripts/cosmos-ots.py verify",
    "ots:upgrade": "python scripts/cosmos-ots.py upgrade",
    "v2:checkpoint": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gerar-checkpoint-cosmos.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-slot": "1.5.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "preact": "^11.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "z3-solver": "^5.2.0"
  }
}
